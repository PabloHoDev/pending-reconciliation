# Copie para .env.local. Nunca coloque valores reais neste arquivo.

# Sem DATABASE_URL, o ambiente local usa PGlite em .pglite/ (ADR-0002).
# Preview e produção recebem a URL da integração Neon-Vercel.
DATABASE_URL=

# Segredo para assinar a sessão das personas de demonstração (gere com: openssl rand -base64 32)
SESSION_SECRET=

# Login do operador (GitHub OAuth)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
OPERATOR_GITHUB_LOGIN=
